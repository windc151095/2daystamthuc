{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Registration information for attendees",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "contacted", "potential", "joined"] },
        "notes": { "type": "string" },
        "history": { 
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "phone", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "zaloLink": { "type": "string" }
      },
      "required": ["zaloLink"]
    },
    "ShowcaseItem": {
      "title": "Showcase Item",
      "description": "Visual transformation or exercise application content",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "description": "URL of the image" },
        "title": { "type": "string", "description": "Title of the lesson/transformation" },
        "description": { "type": "string", "description": "Short description" },
        "order": { "type": "number", "description": "Display order" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "title", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of visitor registrations"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "App settings like Zalo group link"
    },
    "/showcase/{itemId}": {
      "schema": "ShowcaseItem",
      "description": "Transformation album items"
    }
  }
}
