rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.createdAt is string;
    }

    function isSystemAdmin() {
      // For this app, we trust the specific user email or a specific internal role
      return isSignedIn() && (request.auth.token.email == 'congnguyen151095@gmail.com');
    }

    // Leads collection
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow list, get: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow get: if true;
      allow update: if isSystemAdmin() && 
                    request.resource.data.keys().hasOnly(['zaloLink']) &&
                    request.resource.data.zaloLink is string;
    }
  }
}
