rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
             data.createdAt is timestamp;
    }

    function isSystemAdmin() {
      return isSignedIn() && (request.auth.token.email == 'congnguyen151095@gmail.com' && request.auth.token.email_verified == true);
    }

    // Leads collection
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data) && request.resource.data.createdAt == request.time;
      allow list, get, update, delete: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow get: if true;
      allow create, update: if isSystemAdmin() && 
                            request.resource.data.keys().hasOnly(['zaloLink']) &&
                            request.resource.data.zaloLink is string;
    }

    // Showcase collection
    match /showcase/{itemId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }
  }
}
